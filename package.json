{
  "name": "@dsh-external/dsh-session-plus",
  "version": "0.1.0",
  "description": "DSH Web 侧栏会话增强包：彻底删除会话 + 单列表视图下的会话分组。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "sidebar",
    "group"
  ],
  "homepage": "https://github.com/lizhanzhan89/dsh-session-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizhanzhan89/dsh-session-plus.git"
  },
  "bugs": {
    "url": "https://github.com/lizhanzhan89/dsh-session-plus/issues"
  },
  "author": "lizhanzhan89",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/build-client.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  }
}
