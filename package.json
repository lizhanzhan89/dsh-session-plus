{
  "name": "@dsh-external/dsh-session-plus",
  "version": "0.1.0",
  "description": "Session Plus for the DSH Web sidebar: delete sessions permanently and organize the flat (single-list) view into groups with drag & drop and the session menu. | 中文：DSH Web 侧栏会话增强包：彻底删除会话；在单列表视图下创建会话组，通过拖拽或会话菜单把会话移入分组。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/build-client.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  }
}